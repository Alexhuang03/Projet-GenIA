# Fournisseur LLM : "ollama" (défaut, local), "groq", "gemini", "openai"
# ("mock" = réponses factices pour tester l'interface ; refusé par eval.py)
LLM_PROVIDER=ollama
LLM_MODEL=default            # défaut ollama : qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# Recherche du Niveau 1 : "hybrid" (BM25 + dense, fusion RRF), "bm25" ou "dense"
RAG_RETRIEVER=hybrid
EMBEDDING_MODEL=bge-m3       # modèle d'embeddings servi par Ollama

# Clés d'API optionnelles (fournisseurs en ligne) :
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# OPENAI_API_KEY=...
