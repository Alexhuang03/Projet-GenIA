# Configuration des fournisseurs LLM (au choix)
# Aucun GPU ni clé obligatoire pour faire tourner le système :
# Par défaut, le mode "mock" garantit une exécution déterministe hors-ligne instantanée.

# Fournisseur actif : "mock", "gemini", "groq", "openai"
LLM_PROVIDER=mock
LLM_MODEL=default

# Clés d'API optionnelles (si utilisation d'un modèle en ligne) :
# GEMINI_API_KEY=AIzaSy...
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
